+/**
+ * Handle stylus motion events (hover and touch)
+ * Dispatches to plugin system for stylus-aware plugins
+ */
+auto XournalView::onStylusMotionEvent(GtkWidget* widget, GdkEventMotion* event) -> bool {
+    GdkDevice* device = gdk_event_get_source_device((GdkEvent*)event);
+    if (!device) {
+        return false;
+    }
+
+    GdkInputSource source = gdk_device_get_source(device);
+
+    // Only handle stylus/pen/eraser events
+    if (source != GDK_SOURCE_PEN && source != GDK_SOURCE_ERASER) {
+        return false;
+    }
+
+    // Get coordinates and pressure
+    double x = event->x;
+    double y = event->y;
+    double pressure = 0.0;
+
+    GdkDevice* sourceDevice = gdk_event_get_source_device((GdkEvent*)event);
+    if (sourceDevice && gdk_device_get_n_axes(sourceDevice) > 2) {
+        gdk_event_get_axis((GdkEvent*)event, GDK_AXIS_PRESSURE, &pressure);
+    }
+
+    // Notify plugins
+    if (this->control->getPluginController()) {
+        std::string eventType = (pressure > 0.01) ? "tap" : "hover";
+        this->control->getPluginController()->notifyStylusEvent(eventType, x, y, pressure);
+    }
+
+    return false;  // Don't consume the event
+}
+
+
+/**
+ * Handle stylus button events
+ * Dispatches to plugin system
+ */
+auto XournalView::onStylusButtonEvent(GtkWidget* widget, GdkEventButton* event) -> bool {
+    GdkDevice* device = gdk_event_get_source_device((GdkEvent*)event);
+    if (!device) {
+        return false;
+    }
+
+    GdkInputSource source = gdk_device_get_source(device);
+
+    // Only handle stylus/pen events
+    if (source != GDK_SOURCE_PEN && source != GDK_SOURCE_ERASER) {
+        return false;
+    }
+
+    // Get button number and state
+    guint button = event->button;
+    bool pressed = (event->type == GDK_BUTTON_PRESS);
+    double x = event->x;
+    double y = event->y;
+
+    // Notify plugins
+    if (this->control->getPluginController()) {
+        this->control->getPluginController()->notifyStylusEvent("button", x, y, 0.0, button, pressed);
+    }
+
+    return false;  // Don't consume the event
+}
+
+
+/**
+ * Handle stylus proximity events
+ * Called when stylus enters or leaves detection range
+ */
+auto XournalView::onProximityEvent(GtkWidget* widget, GdkEventProximity* event) -> bool {
+    GdkDevice* device = gdk_event_get_source_device((GdkEvent*)event);
+    if (!device) {
+        return false;
+    }
+
+    GdkInputSource source = gdk_device_get_source(device);
+    if (source != GDK_SOURCE_PEN && source != GDK_SOURCE_ERASER) {
+        return false;
+    }
+
+    bool entering = (event->type == GDK_PROXIMITY_IN);
+    if (this->control->getPluginController()) {
+        this->control->getPluginController()->notifyProximityEvent(entering);
+    }
+
+    return false;
+}
