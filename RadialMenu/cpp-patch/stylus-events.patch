+/**
+ * Register handler for stylus events
+ *
+ * Lua example:
+ * app.registerStylusHandler({
+ *   hover = function(x, y, pressure) ... end,
+ *   tap = function(x, y, pressure) ... end,
+ *   button = function(buttonNum, pressed, x, y) ... end,
+ *   proximity_in = function() ... end,
+ *   proximity_out = function() ... end
+ * })
+ */
+auto Plugin::registerStylusHandler(lua_State* L) -> int {
+    Plugin* plugin = Plugin::checkFromLua(L);
+
+    // Argument must be a table with callback functions
+    if (!lua_istable(L, 1)) {
+        return luaL_error(L, "registerStylusHandler: argument must be a table");
+    }
+
+    // If there's an existing handler, unref it
+    if (plugin->stylusHandlerRef != LUA_NOREF) {
+        luaL_unref(L, LUA_REGISTRYINDEX, plugin->stylusHandlerRef);
+    }
+
+    // Store reference to callback table
+    lua_pushvalue(L, 1);
+    plugin->stylusHandlerRef = luaL_ref(L, LUA_REGISTRYINDEX);
+
+    g_message("Plugin '%s': Registered stylus event handler", plugin->name.c_str());
+
+    return 0;
+}
+
+
+/**
+ * Get current stylus state
+ *
+ * Returns table: {x, y, pressure, proximity, buttons}
+ */
+auto Plugin::getStylusState(lua_State* L) -> int {
+    Plugin* plugin = Plugin::checkFromLua(L);
+
+    // Create table for return value
+    lua_newtable(L);
+
+    // Add coordinates
+    lua_pushnumber(L, plugin->lastStylusState.x);
+    lua_setfield(L, -2, "x");
+
+    lua_pushnumber(L, plugin->lastStylusState.y);
+    lua_setfield(L, -2, "y");
+
+    // Add pressure
+    lua_pushnumber(L, plugin->lastStylusState.pressure);
+    lua_setfield(L, -2, "pressure");
+
+    // Add proximity
+    lua_pushboolean(L, plugin->lastStylusState.proximity);
+    lua_setfield(L, -2, "proximity");
+
+    // Add button states as array
+    lua_newtable(L);
+    for (size_t i = 0; i < 3; i++) {
+        lua_pushboolean(L, plugin->lastStylusState.buttons[i]);
+        lua_rawseti(L, -2, i + 1);  // Lua arrays are 1-indexed
+    }
+    lua_setfield(L, -2, "buttons");
+
+    return 1;  // Return the table
+}
+
+
+/**
+ * Notify plugin of stylus event
+ * Called by PluginController when stylus event occurs
+ */
+void Plugin::notifyStylusEvent(const std::string& eventType, double x, double y,
+                                 double pressure, int button, bool pressed) {
+    if (this->stylusHandlerRef == LUA_NOREF) {
+        return;  // No handler registered
+    }
+
+    // Update cached state
+    lastStylusState.x = x;
+    lastStylusState.y = y;
+    lastStylusState.pressure = pressure;
+    if (button > 0 && button <= 3) {
+        lastStylusState.buttons[button - 1] = pressed;
+    }
+
+    // Get callback table from registry
+    lua_rawgeti(this->lua, LUA_REGISTRYINDEX, this->stylusHandlerRef);
+
+    // Get specific callback (hover, tap, button, etc.)
+    lua_getfield(this->lua, -1, eventType.c_str());
+
+    if (!lua_isfunction(this->lua, -1)) {
+        lua_pop(this->lua, 2);  // Pop function and table
+        return;  // No callback for this event type
+    }
+
+    // Push arguments based on event type
+    lua_pushnumber(this->lua, x);
+    lua_pushnumber(this->lua, y);
+
+    int nargs = 2;
+
+    if (eventType == "button") {
+        lua_pushinteger(this->lua, button);
+        lua_pushboolean(this->lua, pressed);
+        nargs = 4;
+    } else if (eventType == "hover" || eventType == "tap") {
+        lua_pushnumber(this->lua, pressure);
+        nargs = 3;
+    } else if (eventType == "proximity_in" || eventType == "proximity_out") {
+        nargs = 0;
+        lua_pop(this->lua, 2);  // Pop x and y, not needed for proximity events
+    }
+
+    // Call the Lua function
+    if (lua_pcall(this->lua, nargs, 0, 0) != 0) {
+        g_warning("Plugin '%s': Error in stylus %s handler: %s",
+                  this->name.c_str(), eventType.c_str(), lua_tostring(this->lua, -1));
+        lua_pop(this->lua, 1);
+    }
+
+    lua_pop(this->lua, 1);  // Pop callback table
+}
+

