+---
+-- Register a handler for stylus/pen input events
+-- This allows plugins to respond to stylus hover, tap, and button events
+-- @param handler table containing callback functions:
+--   - hover(x, y, pressure): called when stylus moves (hovering or touching)
+--   - tap(x, y, pressure): called when stylus taps the surface
+--   - button(buttonNum, pressed, x, y): called when stylus button is pressed/released
+--   - proximity_in(): called when stylus enters proximity
+--   - proximity_out(): called when stylus leaves proximity
+-- @return nil
+function app.registerStylusHandler(handler)
+end
+
+
+---
+-- Get the current state of the stylus/pen
+-- @return table with stylus state: {
+--   x: number,           -- X coordinate
+--   y: number,           -- Y coordinate
+--   pressure: number,    -- Pressure value (0.0 to 1.0)
+--   proximity: boolean,  -- Whether stylus is in proximity
+--   buttons: table       -- Array of button states (indexed from 1)
+-- }
+function app.getStylusState()
+end
+
